  "articles": [],
  "special_terms": [
    {
      "item_order": 1,
      "original_text": "계약기간 중 월 차임은 당사자 합의 없이 인상하지 않는다.",
      "source": { "page_number": 3 }
    },
    {
      "item_order": 2,
      "original_text": "보일러·배관 등 주요 설비의 노후 고장은 임대인이 수리한다.",
      "source": { "page_number": 3 }
    },
    {
      "item_order": 3,
      "original_text": "임차인의 고의·과실로 발생한 파손과 소모품 교체는 임차인이 부담한다.",
      "source": { "page_number": 3 }
    },
    {
      "item_order": 4,
      "original_text": "실내 흡연과 반려동물 사육을 금지한다.",
      "source": { "page_number": 3 }
    },
    {
      "item_order": 5,
      "original_text": "퇴실 청소비 150,000원은 오염 여부와 관계없이 임차인이 부담한다.",
      "source": { "page_number": 3 }
    },
    {
      "item_order": 6,
      "original_text": "임차인이 중도 퇴실할 경우 새 임차인을 구하고 임대인 측 중개보수까지 부담해야 보증금을 반환한다.",
      "source": { "page_number": 3 }
    }
  ],
