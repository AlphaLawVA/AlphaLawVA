LAW_API_KEY=your_open_law_api_key
OPENAI_API_KEY=your_openai_api_key
KOREAN_DICTIONARY_API_KEY=your_standard_korean_dictionary_api_key
KOREAN_TERMS_API_KEY=your_onterm_api_key
URIMALSAEM_API_KEY=your_urimalsaem_api_key

# Optional: change local data output root.
ALPHALAWVA_LOCAL_DATA_DIR=local_data
# Optional: share an existing secrets file with a Git worktree.
ALPHALAWVA_ENV_FILE=.env

# Optional: point API retrieval at existing local vector stores and model cache.
ALPHALAWVA_PRECEDENT_DB_DIR=local_data/precedents/vector_dbs/precedents_bge-m3_v1
ALPHALAWVA_STATUTE_DB_DIR=data/statutes/vectorstores/bge_m3
ALPHALAWVA_MODEL_CACHE_DIR=data/statutes/models

# Comma-separated browser origins allowed to call the local FastAPI server.
ALPHALAWVA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Auth settings used by FastAPI to verify browser access tokens.
# The publishable key is intended for client use; never put a secret/service key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Confirmed snapshot storage and local Docker MySQL.
# Keep memory for a database-free API; set mysql in your untracked .env to persist.
# Use different strong passwords in your untracked .env.
# Port 3307 avoids a conflict with an existing host MySQL on 3306.
MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=replace_with_a_strong_local_root_password
SNAPSHOT_STORE_BACKEND=memory
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=alphalawva
MYSQL_USER=alphalawva_app
MYSQL_PASSWORD=replace_with_a_strong_local_app_password
# Enable only while intentionally running the local MySQL integration test.
RUN_MYSQL_INTEGRATION_TESTS=0

# Optional process-level bootstrap for running code from a separate Git worktree.
# Set this before server startup; relative data paths are resolved from its folder.
# ALPHALAWVA_ENV_FILE=/absolute/path/to/AlphaLawVA/.env

# Set true only after local BGE-M3 models and both statute/precedent ChromaDBs
# are ready. The first enabled request lazily loads the local embedding model.
CONTRACT_REVIEW_RAG_ENABLED=false

# Optional Gemini evidence-bound contract review summary. Keep false until a
# specific paid-call approval is obtained for the document and evidence scope.
CONTRACT_REVIEW_LLM_ENABLED=false
CONTRACT_REVIEW_GEMINI_MODEL=gemini-3.5-flash-lite
CONTRACT_REVIEW_GEMINI_TIMEOUT_SECONDS=30
CONTRACT_REVIEW_GEMINI_MAX_OUTPUT_TOKENS=800
CONTRACT_REVIEW_GEMINI_USAGE_MANIFEST=local_data/contract_review/manifests/gemini_usage.jsonl

# Special clause RAG and generation are opt-in. Gemini usage is recorded locally.
SPECIAL_CLAUSE_RAG_ENABLED=false
SPECIAL_CLAUSE_LLM_ENABLED=false
SPECIAL_CLAUSE_GEMINI_MODEL=gemini-3.5-flash-lite
SPECIAL_CLAUSE_GEMINI_TIMEOUT_SECONDS=30
SPECIAL_CLAUSE_GEMINI_MAX_OUTPUT_TOKENS=1000
SPECIAL_CLAUSE_GEMINI_USAGE_MANIFEST=local_data/special_clause/manifests/gemini_usage.jsonl

# Optional precedent collection tuning.
PRECEDENT_COLLECTION_DELAY_SECONDS=0.3
PRECEDENT_COLLECTION_TIMEOUT_SECONDS=30
PRECEDENT_COLLECTION_MAX_RETRIES=3

# Optional precedent local LLM classification settings.
OLLAMA_BASE_URL=http://127.0.0.1:11434
PRECEDENT_LLM_MODEL=gemma2:9b
PRECEDENT_CLASSIFICATION_PROVIDER=gemini
PRECEDENT_LOCAL_MAX_REASON_CHARS=5000
PRECEDENT_OLLAMA_NUM_CTX=8192
PRECEDENT_OLLAMA_NUM_PREDICT=1200

# Optional precedent search similarity explanation with Gemini.
PRECEDENT_SIMILARITY_LLM_ENABLED=true
PRECEDENT_SIMILARITY_GEMINI_MODEL=gemini-3.5-flash-lite
PRECEDENT_SIMILARITY_GEMINI_TIMEOUT_SECONDS=30
PRECEDENT_SIMILARITY_GEMINI_MAX_OUTPUT_TOKENS=320
PRECEDENT_SIMILARITY_GEMINI_USAGE_MANIFEST=local_data/precedents/manifests/gemini_similarity_usage.jsonl

# Optional precedent Gemini classification settings.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
UNCERTAIN_RESOLUTION_GEMINI_MODEL=gemini-3.1-flash-lite

# Temporary certified-letter generation model. Production target is Claude.
CERTIFIED_LETTER_GENERATION_ENABLED=true
CERTIFIED_LETTER_GEMINI_MODEL=gemini-3.5-flash-lite
CERTIFIED_LETTER_GEMINI_TIMEOUT_SECONDS=90
CERTIFIED_LETTER_GEMINI_MAX_OUTPUT_TOKENS=4096
# Optional per-process hard stop for explicitly approved evaluation runs.
CERTIFIED_LETTER_GEMINI_SESSION_BUDGET_USD=
CERTIFIED_LETTER_GEMINI_USAGE_MANIFEST=local_data/certified_letters/manifests/gemini_generation_usage.jsonl
CERTIFIED_LETTER_STATUTE_DB_DIR=data/statutes/vectorstores/bge_m3
CERTIFIED_LETTER_PRECEDENT_DB_DIR=local_data/precedents/vector_dbs/precedents_bge-m3_v1
CERTIFIED_LETTER_MODEL_CACHE_DIR=data/statutes/models
CERTIFIED_LETTER_EMBEDDING_DEVICE=auto
CERTIFIED_LETTER_STATUTE_RERANKER=dense
# Set when testing a local statute cross-encoder; omit for the dense baseline.
CERTIFIED_LETTER_STATUTE_RERANKER_DIR=
CERTIFIED_LETTER_PRECEDENT_RERANKER=bge-reranker-v2-m3
CERTIFIED_LETTER_PRECEDENT_RERANKER_DIR=local_data/models/rerankers/bge-reranker-v2-m3
CERTIFIED_LETTER_RERANKER_DEVICE=auto
CERTIFIED_LETTER_RERANKER_MAX_LENGTH=512
CERTIFIED_LETTER_RERANKER_BATCH_SIZE=16
CERTIFIED_LETTER_RERANKER_TRUST_REMOTE_CODE=false

# Optional precedent summary generation settings.
PRECEDENT_SUMMARY_LLM_MODEL=gemma2:9b
PRECEDENT_SUMMARY_GEMINI_MODEL=gemini-3.1-flash-lite
PRECEDENT_SUMMARY_OLLAMA_NUM_CTX=8192
PRECEDENT_SUMMARY_OLLAMA_NUM_PREDICT=700
