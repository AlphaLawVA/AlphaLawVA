LAW_API_KEY=your_open_law_api_key
OPENAI_API_KEY=your_openai_api_key
KOREAN_DICTIONARY_API_KEY=your_standard_korean_dictionary_api_key
KOREAN_TERMS_API_KEY=your_onterm_api_key
URIMALSAEM_API_KEY=your_urimalsaem_api_key

# Confirmed contract and registry snapshot storage.
# Set SNAPSHOT_STORE_BACKEND=mysql locally after creating the alphalawva DB.
SNAPSHOT_STORE_BACKEND=memory
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=alphalawva
MYSQL_USER=alphalawva_app
MYSQL_PASSWORD=your_mysql_password

# Optional: change local data output root.
ALPHALAWVA_LOCAL_DATA_DIR=local_data

# Set true only after local BGE-M3 models and both statute/precedent ChromaDBs
# are ready. The first enabled request lazily loads the local embedding model.
CONTRACT_REVIEW_RAG_ENABLED=false

# Optional precedent collection tuning.
PRECEDENT_COLLECTION_DELAY_SECONDS=0.3
PRECEDENT_COLLECTION_TIMEOUT_SECONDS=30
PRECEDENT_COLLECTION_MAX_RETRIES=3

# Optional precedent local LLM classification settings.
OLLAMA_BASE_URL=http://127.0.0.1:11434
PRECEDENT_LLM_MODEL=gemma2:9b
PRECEDENT_CLASSIFICATION_PROVIDER=gemini
PRECEDENT_LOCAL_MAX_REASON_CHARS=5000
PRECEDENT_OLLAMA_NUM_CTX=8192
PRECEDENT_OLLAMA_NUM_PREDICT=1200

# Optional precedent search similarity explanation with Gemini.
PRECEDENT_SIMILARITY_LLM_ENABLED=true
PRECEDENT_SIMILARITY_GEMINI_MODEL=gemini-3.5-flash-lite
PRECEDENT_SIMILARITY_GEMINI_TIMEOUT_SECONDS=30
PRECEDENT_SIMILARITY_GEMINI_MAX_OUTPUT_TOKENS=320
PRECEDENT_SIMILARITY_GEMINI_USAGE_MANIFEST=local_data/precedents/manifests/gemini_similarity_usage.jsonl

# Optional precedent Gemini classification settings.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
UNCERTAIN_RESOLUTION_GEMINI_MODEL=gemini-3.1-flash-lite

# Optional precedent summary generation settings.
PRECEDENT_SUMMARY_LLM_MODEL=gemma2:9b
PRECEDENT_SUMMARY_GEMINI_MODEL=gemini-3.1-flash-lite
PRECEDENT_SUMMARY_OLLAMA_NUM_CTX=8192
PRECEDENT_SUMMARY_OLLAMA_NUM_PREDICT=700
